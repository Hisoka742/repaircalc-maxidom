DATABASE_URL=postgresql://maxi:maxi@localhost:5432/maxicalc
REDIS_URL=redis://localhost:6379/0
# Local LLM via Ollama (OpenAI-compatible API); LLM_ENABLED=false -> deterministic fallbacks only
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b
LLM_ENABLED=true
# gpu24 | gpu8 | cpu
HARDWARE_TIER=gpu24
# the organisers' stand: dump it with scripts/sync_stand.py, then CATALOG_PATH=data/stand.jsonl
# default catalog: the dated snapshot of the Maxidom YML feed (scripts/ingest_feed.py)
CATALOG_PATH=data/raw/products_final.json
MODEL_PATH=data/demo_model.joblib
# REDIS_URL=redis://localhost:6379/0   # shared cache (required with several workers)
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_BURST=100
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# --- catalog stand (Bagisto API). One variable switches mock <-> real ---
STAND_BASE_URL=http://127.0.0.1:9000
# STAND_TOKEN=
# STAND_REGION_ID=1
# STAND_CACHE_DIR=data/stand_cache
# STAND_MIN_INTERVAL_S=0.1
# CORS_ORIGINS=https://www.maxidom.ru
